---
import Layout from '../layouts/Layout.astro';

// Welcome to adhdm8.github.io - Your GitHub Pages site powered by Astro
---

<Layout>
  <main>
    <section class="hero">
      <h1>Welcome to adhdm8.github.io</h1>
      <p>This is a static site built with <a href="https://astro.build" target="_blank" rel="noopener">Astro</a> and deployed on GitHub Pages.</p>
      <div class="cta-buttons">
        <a href="/about" class="button primary">Learn More</a>
        <a href="https://github.com/adhdm8" class="button secondary" target="_blank" rel="noopener">View GitHub</a>
      </div>
    </section>
  </main>
</Layout>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 80vh;
    text-align: center;
    padding: 2rem;
  }

  .hero h1 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    color: #2d3748;
  }

  .hero p {
    font-size: 1.2rem;
    max-width: 600px;
    margin-bottom: 2rem;
    color: #4a5568;
  }

  .cta-buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .button {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .button.primary {
    background-color: #3182ce;
    color: white;
  }

  .button.primary:hover {
    background-color: #2c5282;
  }

  .button.secondary {
    background-color: #e2e8f0;
    color: #2d3748;
  }

  .button.secondary:hover {
    background-color: #cbd5e0;
  }
</style>
