---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main>
    <section class="about">
      <h1>About This Site</h1>
      <p>This is a static site built with <a href="https://astro.build" target="_blank" rel="noopener">Astro</a> and deployed on GitHub Pages.</p>
      <p>Astro is a modern static site builder that makes it easy to build fast, content-focused websites. This site is hosted on GitHub Pages, providing free static hosting for GitHub repositories.</p>
      
      <h2>Features</h2>
      <ul>
        <li>Fast loading times</li>
        <li>SEO-friendly</li>
        <li>Modern web standards</li>
        <li>Responsive design</li>
      </ul>
      
      <div class="back-to-home">
        <a href="/" class="button primary">Back to Home</a>
      </div>
    </section>
  </main>
</Layout>

<style>
  .about {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem;
  }

  .about h1 {
    color: #2d3748;
    margin-bottom: 1rem;
  }

  .about h2 {
    color: #4a5568;
    margin: 1.5rem 0 1rem;
  }

  .about p {
    color: #4a5568;
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .about ul {
    padding-left: 1.5rem;
    margin: 1rem 0;
  }

  .about li {
    margin-bottom: 0.5rem;
    color: #4a5568;
  }

  .back-to-home {
    margin-top: 2rem;
    text-align: center;
  }

  .button {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .button.primary {
    background-color: #3182ce;
    color: white;
  }

  .button.primary:hover {
    background-color: #2c5282;
  }
</style>